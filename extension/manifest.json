{
  "manifest_version": 3,
  "name": "tg-media-save",
  "version": "1.0.2",
  "minimum_chrome_version": "111",
  "description": "Save photos, videos, GIFs and voice messages from Telegram Web, including channels with restricted saving.",
  "author": "Denis Ermilov",
  "homepage_url": "https://github.com/LazyFaiz/tg-media-save",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "tg-media-save",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "TG Media Saver",
  "version": "1.0.0",
  "description": "Save photos, videos, GIFs and voice messages from Telegram Web, including channels with restricted saving.",
  "author": "Denis Ermilov",
  "homepage_url": "https://github.com/eiler2005/tg-media-saver",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TG Media Saver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}

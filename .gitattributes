# Normalize line endings to LF on checkin and checkout (prevents CRLF breaking
# script shebangs on Windows checkouts).
* text=auto eol=lf

# Explicitly text, LF
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.yml text eol=lf

# Binary assets — never normalize
*.png binary
*.ico binary
*.zip binary

# Build output. The release zip is committed so users can download it straight from the
# repo (rebuild + recommit it on each release); any other dist/ artifact stays ignored.
dist/*
!dist/tg-media-saver-extension.zip

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Python (used only by scripts/make_icons.py via uv)
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log

# Node (tests use the built-in runner; no runtime deps, but be safe)
node_modules/

# NOTE: tg-media-saver.user.js and extension/content.js are GENERATED by scripts/build.sh
# but intentionally committed (raw-URL install + unpacked loading without a build step).
# Do not ignore them.
